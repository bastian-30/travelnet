{
  "name": "travelnet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8443",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt app src server scripts next.config.ts",
    "api": "tsx watch server/src/index.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "docker:env": "tsx scripts/docker-env.ts",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:migrate": "docker compose --env-file .env.docker run --rm migrate",
    "docker:seed": "docker compose --env-file .env.docker run --rm seed",
    "docker:logs": "docker compose --env-file .env.docker logs -f api web",
    "user:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "hls.js": "^1.7.3",
    "jose": "^6.2.13",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.74.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
